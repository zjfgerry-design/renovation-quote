{
  "name": "renovation-quote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.json *.mjs README.md"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
